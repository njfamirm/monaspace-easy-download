code = "@defaults_can_give_space = [i idotless iacute ibreve icircumflex idieresis idotbelow igrave imacron iogonek i.alt idotless.alt iacute.alt ibreve.alt icircumflex.alt idieresis.alt idotbelow.alt igrave.alt imacron.alt iogonek.alt l lacute lcaron lcommaaccent lslash l.alt lacute.alt lcaron.alt lcommaaccent.alt lslash.alt t tcedilla tcommaaccent f j jcircumflex v I Iacute Ibreve Icircumflex Idieresis Idotaccent Idotbelow Igrave Imacron Iogonek Itilde L Lacute Lcommaaccent Lslash F S Sacute Scaron Scedilla Scircumflex Scommaaccent E Eacute Ebreve Ecaron Ecircumflex Edieresis Edotaccent Edotbelow Egrave Emacron Eogonek Etilde underscore charactertie overline undertie underscoredbl seven one one.alt];
@defaults_can_take_space = [w wacute wcircumflex wdieresis wgrave m ae aeacute oe ij W Wacute Wcircumflex Wdieresis Wgrave won won.nobar M T Tbar Tcaron Tcedilla Tcommaaccent AE AEacute IJ OE numero centigrade fahrenheit kelvin exclamationquestion exclamdouble doublequestion questionexclamation heavySingleTurnedCommaQuotationMarkOrnament heavySingleCommaQuotationMarkOrnament heavyDoubleTurnedCommaQuotationMarkOrnament heavyDoubleCommaQuotationMarkOrnament trademark servicemark percent perthousand at ampersand nAryCircledDotOperator nAryCircledPlusOperator nAryCircledTimesOperator APLdeldieresis APLdelstile APLdeltastile APLdeltaunderbar APLquaddel APLquaddelta colonequals equalsSignWithTwoDotsAboveAndTwoDotsBelow equalscolon equivalence equivalentWithFourDotsAbove gradient midlinehorizontalellipsis muchgreater muchless increment threeConsecutiveEqualsSigns tripleverticalbarrightturnstile twoConsecutiveEqualsSigns twoIntersectingLogicalAnd twoIntersectingLogicalOr twoLogicalAndOperator twoLogicalOrOperator verymuchgreaterthan verymuchlessthan leftRightArrow leftWaveArrow rightWaveArrow leftTwoheadedArrow rightTwoheadedArrow leftTailArrow rightTailArrow leftFrombarArrow rightFrombarArrow leftRightLongArrow];
@can_give_space_left = [i.left idotless.left iacute.left ibreve.left icircumflex.left idieresis.left idotbelow.left igrave.left imacron.left iogonek.left i.alt.left idotless.alt.left iacute.alt.left ibreve.alt.left icircumflex.alt.left idieresis.alt.left idotbelow.alt.left igrave.alt.left imacron.alt.left iogonek.alt.left l.left lacute.left lcaron.left lcommaaccent.left lslash.left l.alt.left lacute.alt.left lcaron.alt.left lcommaaccent.alt.left lslash.alt.left t.left tcedilla.left tcommaaccent.left f.left j.left jcircumflex.left v.left I.left Iacute.left Ibreve.left Icircumflex.left Idieresis.left Idotaccent.left Idotbelow.left Igrave.left Imacron.left Iogonek.left Itilde.left L.left Lacute.left Lcommaaccent.left Lslash.left F.left S.left Sacute.left Scaron.left Scedilla.left Scircumflex.left Scommaaccent.left E.left Eacute.left Ebreve.left Ecaron.left Ecircumflex.left Edieresis.left Edotaccent.left Edotbelow.left Egrave.left Emacron.left Eogonek.left Etilde.left underscore.left charactertie.left overline.left undertie.left underscoredbl.left seven.left one.left one.alt.left];
@can_give_space_right = [i.right idotless.right iacute.right ibreve.right icircumflex.right idieresis.right idotbelow.right igrave.right imacron.right iogonek.right i.alt.right idotless.alt.right iacute.alt.right ibreve.alt.right icircumflex.alt.right idieresis.alt.right idotbelow.alt.right igrave.alt.right imacron.alt.right iogonek.alt.right l.right lacute.right lcaron.right lcommaaccent.right lslash.right l.alt.right lacute.alt.right lcaron.alt.right lcommaaccent.alt.right lslash.alt.right t.right tcedilla.right tcommaaccent.right f.right j.right jcircumflex.right v.right I.right Iacute.right Ibreve.right Icircumflex.right Idieresis.right Idotaccent.right Idotbelow.right Igrave.right Imacron.right Iogonek.right Itilde.right L.right Lacute.right Lcommaaccent.right Lslash.right F.right S.right Sacute.right Scaron.right Scedilla.right Scircumflex.right Scommaaccent.right E.right Eacute.right Ebreve.right Ecaron.right Ecircumflex.right Edieresis.right Edotaccent.right Edotbelow.right Egrave.right Emacron.right Eogonek.right Etilde.right underscore.right charactertie.right overline.right undertie.right underscoredbl.right seven.right one.right one.alt.right];
@can_take_space_left = [w.left wacute.left wcircumflex.left wdieresis.left wgrave.left m.left ae.left aeacute.left oe.left ij.left W.left Wacute.left Wcircumflex.left Wdieresis.left Wgrave.left won.left won.nobar.left M.left T.left Tbar.left Tcaron.left Tcedilla.left Tcommaaccent.left AE.left AEacute.left IJ.left OE.left numero.left centigrade.left fahrenheit.left kelvin.left exclamationquestion.left exclamdouble.left doublequestion.left questionexclamation.left heavySingleTurnedCommaQuotationMarkOrnament.left heavySingleCommaQuotationMarkOrnament.left heavyDoubleTurnedCommaQuotationMarkOrnament.left heavyDoubleCommaQuotationMarkOrnament.left trademark.left servicemark.left percent.left perthousand.left at.left ampersand.left nAryCircledDotOperator.left nAryCircledPlusOperator.left nAryCircledTimesOperator.left APLdeldieresis.left APLdelstile.left APLdeltastile.left APLdeltaunderbar.left APLquaddel.left APLquaddelta.left colonequals.left equalsSignWithTwoDotsAboveAndTwoDotsBelow.left equalscolon.left equivalence.left equivalentWithFourDotsAbove.left gradient.left midlinehorizontalellipsis.left muchgreater.left muchless.left increment.left threeConsecutiveEqualsSigns.left tripleverticalbarrightturnstile.left twoConsecutiveEqualsSigns.left twoIntersectingLogicalAnd.left twoIntersectingLogicalOr.left twoLogicalAndOperator.left twoLogicalOrOperator.left verymuchgreaterthan.left verymuchlessthan.left leftRightArrow.left leftWaveArrow.left rightWaveArrow.left leftTwoheadedArrow.left rightTwoheadedArrow.left leftTailArrow.left rightTailArrow.left leftFrombarArrow.left rightFrombarArrow.left leftRightLongArrow.left];
@can_take_space_right = [w.right wacute.right wcircumflex.right wdieresis.right wgrave.right m.right ae.right aeacute.right oe.right ij.right W.right Wacute.right Wcircumflex.right Wdieresis.right Wgrave.right won.right won.nobar.right M.right T.right Tbar.right Tcaron.right Tcedilla.right Tcommaaccent.right AE.right AEacute.right IJ.right OE.right numero.right centigrade.right fahrenheit.right kelvin.right exclamationquestion.right exclamdouble.right doublequestion.right questionexclamation.right heavySingleTurnedCommaQuotationMarkOrnament.right heavySingleCommaQuotationMarkOrnament.right heavyDoubleTurnedCommaQuotationMarkOrnament.right heavyDoubleCommaQuotationMarkOrnament.right trademark.right servicemark.right percent.right perthousand.right at.right ampersand.right nAryCircledDotOperator.right nAryCircledPlusOperator.right nAryCircledTimesOperator.right APLdeldieresis.right APLdelstile.right APLdeltastile.right APLdeltaunderbar.right APLquaddel.right APLquaddelta.right colonequals.right equalsSignWithTwoDotsAboveAndTwoDotsBelow.right equalscolon.right equivalence.right equivalentWithFourDotsAbove.right gradient.right midlinehorizontalellipsis.right muchgreater.right muchless.right increment.right threeConsecutiveEqualsSigns.right tripleverticalbarrightturnstile.right twoConsecutiveEqualsSigns.right twoIntersectingLogicalAnd.right twoIntersectingLogicalOr.right twoLogicalAndOperator.right twoLogicalOrOperator.right verymuchgreaterthan.right verymuchlessthan.right leftRightArrow.right leftWaveArrow.right rightWaveArrow.right leftTwoheadedArrow.right rightTwoheadedArrow.right leftTailArrow.right rightTailArrow.right leftFrombarArrow.right rightFrombarArrow.right leftRightLongArrow.right];
@can_take_space_both = [w.both wacute.both wcircumflex.both wdieresis.both wgrave.both m.both ae.both aeacute.both oe.both ij.both W.both Wacute.both Wcircumflex.both Wdieresis.both Wgrave.both won.both won.nobar.both M.both T.both Tbar.both Tcaron.both Tcedilla.both Tcommaaccent.both AE.both AEacute.both IJ.both OE.both numero.both centigrade.both fahrenheit.both kelvin.both exclamationquestion.both exclamdouble.both doublequestion.both questionexclamation.both heavySingleTurnedCommaQuotationMarkOrnament.both heavySingleCommaQuotationMarkOrnament.both heavyDoubleTurnedCommaQuotationMarkOrnament.both heavyDoubleCommaQuotationMarkOrnament.both trademark.both servicemark.both percent.both perthousand.both at.both ampersand.both nAryCircledDotOperator.both nAryCircledPlusOperator.both nAryCircledTimesOperator.both APLdeldieresis.both APLdelstile.both APLdeltastile.both APLdeltaunderbar.both APLquaddel.both APLquaddelta.both colonequals.both equalsSignWithTwoDotsAboveAndTwoDotsBelow.both equalscolon.both equivalence.both equivalentWithFourDotsAbove.both gradient.both midlinehorizontalellipsis.both muchgreater.both muchless.both increment.both threeConsecutiveEqualsSigns.both tripleverticalbarrightturnstile.both twoConsecutiveEqualsSigns.both twoIntersectingLogicalAnd.both twoIntersectingLogicalOr.both twoLogicalAndOperator.both twoLogicalOrOperator.both verymuchgreaterthan.both verymuchlessthan.both leftRightArrow.both leftWaveArrow.both rightWaveArrow.both leftTwoheadedArrow.both rightTwoheadedArrow.both leftTailArrow.both rightTailArrow.both leftFrombarArrow.both rightFrombarArrow.both leftRightLongArrow.both];
@stationary = [period comma parenleft parenright braceleft braceright bracketleft bracketright];


		
lookup defaultLeftPass {
    #if a glyph that can take space is to the left of a glyph that can give space, cause the glyph that can give space to extend to the right
    #sample: im = i.left m;
    sub @defaults_can_give_space' @defaults_can_take_space by @can_give_space_left;
} defaultLeftPass;

lookup defaultRightPass {
    #if a glyph that can take space is to the right of a glyph that can give space, cause the glyph that can give space to extend to the left
    #sample: ml = m l.right;
    sub @defaults_can_take_space @defaults_can_give_space' by @can_give_space_right;
} defaultRightPass;

lookup centerPass {
    #if a glyph that can take space is between two glyphs that can give space, cause the glyph that can take space to extend in both directions outwards
    #this also requires that the 1st and 3rd glyphs have already been swapped to .left and .right respectively by the defaultLeftPass and defaultRightPass lookups
    #sample: iml = i.left m.both l.right;
    sub @can_give_space_left @defaults_can_take_space' @can_give_space_right by @can_take_space_both;
} centerPass;



lookup secondLeftPass {
    #if a glyph was swapped to a .left and is followed by a glyph that can take space, cause the glyph that can take space to extend to the left
    #sample i.left m = i.left m.right;
    sub @can_give_space_left @defaults_can_take_space' by @can_take_space_left;
} secondLeftPass;

lookup secondRightPass {
    #if a glyph was swapped to a .right and is preceded by a glyph that can take space, cause the glyph that can take space to extend to the right
    #sample m l.right = m.left l.right;
    sub @defaults_can_take_space' @can_give_space_right by @can_take_space_right;
} secondRightPass;




lookup stationaryLeftPass {
	#some glyphs like the period can remain stationary because they have tons of space on both sides, while glyphs on the left of them can take space, they will not be moved
	#sample period m = period m.right;
	sub @stationary @defaults_can_take_space' by @can_take_space_left;
} stationaryLeftPass;

lookup stationaryRightPass {
	#some glyphs like the period can remain stationary because they have tons of space on both sides, while glyphs on the right of them can take space, they will not be moved
	#sample m period = m.left period;
	sub @defaults_can_take_space' @stationary by @can_take_space_right;
} stationaryRightPass;


lookup stationaryLeftSecondPass {
	#for a string such as i.left m.left period, the period can stay stationary and the m.left can become m.both
	#sample i.left m.left period = i.left m.both period;
    sub @can_give_space_left @can_take_space_left' @stationary by @can_take_space_both;
} stationaryLeftSecondPass;

lookup stationaryRightSecondPass {
	#for a string such as period m.right l.right, the period can stay stationary and the m.right can become m.both
	#sample period m.right l.right = period m.both l.right;
	sub @stationary @can_take_space_right' @can_give_space_right by @can_take_space_both;
} stationaryRightSecondPass;

lookup stationaryCenterPass {
	#ultimately we want a string like \"period m period\" to become \"period m.both period\"
	#as a result of earlier lookups, the string could initially be something like period m.left period
	#or it could be period m.right period
	#this lookup will take care of both cases
	#sample period m.left period = period m.both period;
	sub @stationary @can_take_space_both' @stationary by @can_take_space_both;
	sub @stationary @can_take_space_left' @stationary by @can_take_space_both;
	sub @stationary @can_take_space_right' @stationary by @can_take_space_both;
} stationaryCenterPass;

		



#ifdef VARIABLE


lookup defaultLeftPass;
lookup defaultRightPass;
lookup centerPass;

lookup secondLeftPass;
lookup secondRightPass;

lookup stationaryLeftPass;
lookup stationaryRightPass;
lookup stationaryLeftSecondPass;
lookup stationaryRightSecondPass;
lookup stationaryCenterPass;
		
		


lookup defaultLeftPass;
lookup defaultRightPass;
lookup centerPass;

lookup secondLeftPass;
lookup secondRightPass;

lookup stationaryLeftPass;
lookup stationaryRightPass;
lookup stationaryLeftSecondPass;
lookup stationaryRightSecondPass;
lookup stationaryCenterPass;
		
		



condition 599 < wght;




sub dollar by dollar.nobar;
sub cent by cent.nobar;
sub won by won.nobar;
sub dollar.left by dollar.nobar.left;
sub dollar.right by dollar.nobar.right;
sub dollar.both by dollar.nobar.both;
		




lookup defaultLeftPass;
lookup defaultRightPass;
lookup centerPass;

lookup secondLeftPass;
lookup secondRightPass;

lookup stationaryLeftPass;
lookup stationaryRightPass;
lookup stationaryLeftSecondPass;
lookup stationaryRightSecondPass;
lookup stationaryCenterPass;
		
		

#endif";
tag = calt;
},
{
automatic = 1;
code = "lookup ccmp_Other_1 {
	@CombiningTopAccents = [acutecomb brevecomb caroncomb circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub i' @CombiningTopAccents by idotless;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_Other_1;

lookup ccmp_Other_2 {
	lookupflag 0;
	@Markscomb = [dieresiscomb dotaccentcomb gravecomb acutecomb hungarumlautcomb circumflexcomb caroncomb brevecomb ringcomb tildecomb macroncomb];
	@MarkscombCase = [dieresiscomb.case dotaccentcomb.case gravecomb.case acutecomb.case hungarumlautcomb.case circumflexcomb.case caroncomb.case brevecomb.case ringcomb.case tildecomb.case macroncomb.case];
	sub @Uppercase @Markscomb' by @MarkscombCase;
} ccmp_Other_2;

lookup ccmp_Other_3 {
	lookupflag 0;
	sub @MarkscombCase @Markscomb' by @MarkscombCase;
} ccmp_Other_3;
";
tag = ccmp;
},
{
automatic = 1;
code = "script latn;
language ROM;
lookup locl_latn_0 {
	sub Scedilla by Scommaaccent;
	sub scedilla by scommaaccent;
	sub Tcedilla by Tcommaaccent;
	sub tcedilla by tcommaaccent;
} locl_latn_0;
language MOL;
lookup locl_latn_0;

script latn;
language CAT;
lookup locl_latn_1 {
	sub  l' periodcentered' l by ldot;
	sub  L' periodcentered' L by Ldot;
} locl_latn_1;
";
