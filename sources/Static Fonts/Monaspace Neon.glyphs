    ignore sub asciitilde' asciitilde greater greater;
    ignore sub asciitilde asciitilde' asciitilde greater;
    ignore sub less asciitilde' asciitilde greater;
    sub asciitilde' asciitilde' greater' by asciitilde_asciitilde_greater;
} asciitilde_asciitilde_greater;

lookup less_asciitilde_greater {
    # Contextual substitution for '<~>' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde greater;
    ignore sub less' asciitilde greater greater;
    sub less' asciitilde' greater' by less_asciitilde_greater;
} less_asciitilde_greater;

lookup less_asciitilde {
    # Contextual substitution for '<~' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde;
    ignore sub less' asciitilde greater;
    sub less' asciitilde' by less_asciitilde;
} less_asciitilde;

lookup asciitilde_greater {
    # Contextual substitution for '~>' not followed by '>' or preceded by '<'.
    ignore sub asciitilde' greater greater;
    ignore sub less asciitilde' greater;
    sub asciitilde' greater' by asciitilde_greater;
} asciitilde_greater;














lookup ss03_EAW {
    sub less_hyphen_hyphen_greater by emptyAdvanceWidth emptyAdvanceWidth emptyAdvanceWidth less_hyphen_hyphen_greater;
    sub less_exclam_hyphen_hyphen by emptyAdvanceWidth emptyAdvanceWidth emptyAdvanceWidth less_exclam_hyphen_hyphen;
