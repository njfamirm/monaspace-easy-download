{
code = "featureNames {
   name \"SS05: F# Shapes\"; 
};

lookupflag IgnoreMarks;

lookup slash_backslash {
    # Contextual substitution for '/\\' not followed by '\\' or preceded by '/'.
    ignore sub slash slash' backslash;
    ignore sub slash' backslash backslash;
    sub slash' backslash' by slash_backslash;
} slash_backslash;

lookup backslash_slash {
    # Contextual substitution for '\\/' not followed by '/' or preceded by '\\'.
    ignore sub backslash backslash' slash;
    ignore sub backslash' slash slash;
    sub backslash' slash' by backslash_slash;
} backslash_slash;

lookup less_bar_greater {
    # Contextual substitution for '<|>' not preceded by '<' or followed by '>'.
    ignore sub less' bar' greater' greater;
    ignore sub less less' bar' greater';
    sub less' bar' greater' by less_bar_greater;
} less_bar_greater;

lookup bar_greater {
    # Contextual substitution for '|>' not followed by '>'.
    ignore sub bar' greater greater;
    sub bar' greater' by bar_greater;
} bar_greater;

lookup less_bar {
    # Contextual substitution for '<|' not preceded by '<'.
    ignore sub less less' bar;
    sub less' bar' by less_bar;
} less_bar;

lookup bracketleft_bar {
    # Contextual substitution for '[|' not followed by '|' or preceded by '['.
    ignore sub bracketleft bracketleft' bar';
    ignore sub bracketleft' bar' bar;
    sub bracketleft' bar' by bracketleft_bar;
} bracketleft_bar;

lookup bar_bracketright {
    # Contextual substitution for '|]' not followed by ']' or preceded by '|'.
    ignore sub bar bar' bracketright';
    ignore sub bar' bracketright' bracketright;
    sub bar' bracketright' by bar_bracketright;
} bar_bracketright;

lookup braceleft_bar {
    # Contextual substitution for '{|' not followed by '|' or preceded by '{'.
    ignore sub braceleft braceleft' bar';
    ignore sub braceleft' bar' bar;
    sub braceleft' bar' by braceleft_bar;
} braceleft_bar;

lookup bar_braceright {
    # Contextual substitution for '|}' not followed by '}' or preceded by '|'.
    ignore sub bar bar' braceright';
    ignore sub bar' braceright' braceright;
    sub bar' braceright' by bar_braceright;
} bar_braceright;





















lookup ss05_EAW {
    sub slash_backslash by emptyAdvanceWidth slash_backslash;
    sub backslash_slash by emptyAdvanceWidth backslash_slash;
    sub less_bar_greater by emptyAdvanceWidth emptyAdvanceWidth less_bar_greater;
    sub bar_greater by emptyAdvanceWidth bar_greater;
    sub less_bar by emptyAdvanceWidth less_bar;
    sub bracketleft_bar by emptyAdvanceWidth bracketleft_bar;
    sub bar_bracketright by emptyAdvanceWidth bar_bracketright;
    sub braceleft_bar by emptyAdvanceWidth braceleft_bar;
    sub bar_braceright by emptyAdvanceWidth bar_braceright;
} ss05_EAW;";
tag = ss05;
},
{
code = "featureNames {
   name \"SS06: Markdown Strings\"; 
};

@plus = [plus plus.init plus.medi plus.fina];
@numbersign = [numbersign numbersign.init numbersign.medi numbersign.fina];
@equal = [equal equal.init equal.medi equal.fina];

lookupflag IgnoreMarks;



lookup plus.init {
    # Contextual substitution for '++' and '+++'.
    ignore sub @plus @plus';
    sub @plus' @plus by plus.init;
} plus.init;

lookup plus.fina {
    # Contextual substitution for '++' and '+++'.
    ignore sub @plus' @plus;
    sub @plus @plus' by plus.fina;
} plus.fina;

lookup plus.medi {
    # Contextual substitution for '++' and '+++'.
    sub @plus @plus' @plus by plus.medi;
} plus.medi;



lookup numbersign.init {
    # Contextual substitution for '##' and '###'.
    ignore sub @numbersign @numbersign';
    sub @numbersign' @numbersign by numbersign.init;
} numbersign.init;

lookup numbersign.fina {
    # Contextual substitution for '##' and '###'.
    ignore sub @numbersign' @numbersign;
    sub @numbersign @numbersign' by numbersign.fina;
} numbersign.fina;

lookup numbersign.medi {
    # Contextual substitution for '##' and '###'.
    sub @numbersign @numbersign' @numbersign by numbersign.medi;
} numbersign.medi;



lookup equal.init {
    # Contextual substitution for '===='.
    ignore sub [greater less slash backslash exclam asciitilde numbersign period colon] @equal';
    ignore sub @equal @equal';
    sub @equal' @equal by equal.init;
} equal.init;

lookup equal.fina {
    # Contextual substitution for '===='.
    ignore sub @equal' [greater less slash backslash exclam asciitilde numbersign period colon];
    ignore sub @equal' @equal;
    sub @equal @equal' by equal.fina;
} equal.fina;

lookup equal.medi {
    # Contextual substitution for '===='.
    sub @equal @equal' @equal by equal.medi;
} equal.medi;



lookup ampersand_ampersand {
    # Contextual substitution for '&&' and '&&&'
    sub [ampersand ampersand.left ampersand.right ampersand.both]' [ampersand ampersand.left ampersand.right ampersand.both ampersand.init] by ampersand.init;
    sub [ampersand ampersand.left ampersand.right ampersand.both]' emptyAdvanceWidth ampersand_equal by ampersand.init;
} ampersand_ampersand;";
tag = ss06;
},
{
code = "featureNames {
