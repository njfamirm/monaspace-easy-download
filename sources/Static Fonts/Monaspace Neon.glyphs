    ignore sub hyphen' greater greater;
    ignore sub less hyphen' greater;
    sub hyphen' greater' by hyphen_greater;
} hyphen_greater;






lookup less_asciitilde_asciitilde {
    # Contextual substitution for '<~~' not followed by '~' or '>', or preceded by '<'.
    ignore sub less less' asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde greater;
    sub less' asciitilde' asciitilde' by less_asciitilde_asciitilde;
} less_asciitilde_asciitilde;

lookup asciitilde_asciitilde_greater {
